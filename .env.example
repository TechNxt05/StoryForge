# StoryForge Environment Variables Example

# App Setup
NODE_ENV=development
PORT=3000
API_PORT=8000
WORKER_PORT=8001

# Core Services
DATABASE_URL=postgresql://storyforge:storyforge_pass@localhost:5432/storyforge_db
MONGODB_URI=mongodb://localhost:27017/storyforge
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# AI & LLM Providers (To be configured in future prompts)
OPENROUTER_API_KEY=
GEMINI_API_KEY=
VEO_API_KEY=
FLUX_API_KEY=
NANOBANANA_API_KEY=
KOKORO_API_URL=
VOICEBOX_API_KEY=

# Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
