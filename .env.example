# StoryForge AI - backend environment (set these in the Render dashboard).
# Everything works with no AI keys at all; each free key makes generation faster/better.

# --- Required in production -------------------------------------------------
# Long random string. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
# Leave empty to use a local SQLite file (data is lost on every Render restart).
DATABASE_URL=
# Comma-separated frontend origins allowed to call the API, e.g. https://your-app.vercel.app
# (CORS_ORIGIN_REGEX can match Vercel preview URLs, e.g. https://.*\.vercel\.app)
CORS_ORIGINS=*
# Emails that may change provider keys from the Settings page.
ADMIN_EMAILS=

# --- Script writing (LLM) - tried in this order, all optional -----------------
# https://aistudio.google.com/apikey (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# https://console.groq.com/keys (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://openrouter.ai/keys (free models, ~50 requests/day)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Pollinations works without a key (rate limited); a free key from https://enter.pollinations.ai lifts limits.
POLLINATIONS_API_KEY=

# --- Scene images - tried in this order ----------------------------------------
# Cloudflare Workers AI FLUX schnell, 10k free neurons/day: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face inference (small monthly free credit): https://huggingface.co/settings/tokens
HF_TOKEN=
# Then Pollinations (above), then a locally drawn gradient card.

# --- Storage ---------------------------------------------------------------------
# Strongly recommended on free hosting: without it videos live on the server disk and
# disappear when the free instance restarts. Free plan: https://cloudinary.com/users/register_free
# Paste the "API environment variable" from the Cloudinary console (Settings > API Keys):
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET instead.

# --- Tuning (optional) ------------------------------------------------------------
# Short side of rendered videos in pixels. 576 keeps renders fast on 0.1-CPU free instances.
RENDER_SHORT_SIDE=576
# Generations run one at a time on small instances.
MAX_CONCURRENT_JOBS=1
MEDIA_DIR=./media
